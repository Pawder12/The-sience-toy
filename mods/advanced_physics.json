{
  "metadata": {
    "title": "The Particle Simulator — Advanced Physics Module",
    "version": "4.1",
    "author": "TPS Physics Research Division",
    "license": "CC-BY-SA 4.0",
    "description": "Расширенные физические законы: гравитация, ЭМ-поля, давление, вязкость, квантовые эффекты.",
    "reference_data": [
      "NIST Physical Constants",
      "Landau & Lifshitz Course of Theoretical Physics",
      "Feynman Lectures on Physics"
    ]
  },
  "fields": {
    "gravity": {
      "enabled": true,
      "strength_px_per_s2": 9.8,
      "direction": [0, 1],
      "affects_states": ["solid", "liquid", "plasma"],
      "description": "Гравитационное поле. Ускоряет объекты вниз."
    },
    "electromagnetic": {
      "enabled": true,
      "coulomb_constant": 8.99e9,
      "permittivity": 8.85e-12,
      "permeability": 1.26e-6,
      "speed_of_light_m_s": 299792458,
      "max_field_strength_v_m": 1e9,
      "description": "Электрические и магнитные поля. Заряды взаимодействуют по закону Кулона."
    },
    "pressure": {
      "enabled": true,
      "base_pressure_pa": 101325,
      "compressibility_factor": 0.000001,
      "sound_speed_air_m_s": 343,
      "viscosity_air_kg_ms": 0.000018,
      "description": "Давление передаётся между ячейками. Газы сжимаются, жидкости — нет."
    },
    "temperature": {
      "enabled": true,
      "absolute_zero_k": 0,
      "stefan_boltzmann": 5.67e-8,
      "thermal_conductivity_air": 0.026,
      "thermal_conductivity_water": 0.6,
      "description": "Теплопередача через излучение, конвекцию и проводимость."
    },
    "quantum": {
      "enabled": false,
      "planck_constant_j_s": 6.626e-34,
      "hbar": 1.054e-34,
      "tunneling_enabled": true,
      "wavefunction_resolution": 1,
      "description": "Упрощённая модель квантовых эффектов (туннелирование, интерференция)."
    }
  },
