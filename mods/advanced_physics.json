  "forces": {
    "gravity": {
      "formula": "F = G * m1 * m2 / r²",
      "applies_to": ["mass"]
    },
    "coulomb": {
      "formula": "F = k * q1 * q2 / r²",
      "applies_to": ["charge"]
    },
    "lorentz": {
      "formula": "F = q * (E + v × B)",
      "applies_to": ["charged particles in EM field"]
    },
    "drag": {
      "formula": "F = 0.5 * ρ * v² * Cd * A",
      "applies_to": ["moving in fluid"]
    },
    "surface_tension": {
      "formula": "F = γ * L",
      "applies_to": ["liquid interfaces"]
    },
    "elastic_restoring": {
      "formula": "F = -k * x",
      "applies_to": ["springs, rubber"]
    }
  },
  "effects": {
    "doppler_shift": {
      "enabled": true,
      "applies_to": ["sound", "light"],
      "description": "Частота волны меняется при движении источника или наблюдателя."
    },
    "bernoulli_effect": {
      "enabled": true,
      "applies_to": ["fluids"],
      "description": "Давление падает при увеличении скорости потока. Подъёмная сила крыла."
    },
    "capillary_action": {
      "enabled": true,
      "max_height_mm": 50,
      "depends_on": ["tube_diameter", "surface_tension"],
      "description": "Жидкость поднимается в узких трубках против гравитации."
    },
    "turbulence": {
      "enabled": true,
      "reynolds_threshold": 2000,
      "chaotic_flow": true,
      "description": "При высоких скоростях поток становится нестабильным и вихревым."
    }
  }
}